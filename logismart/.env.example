# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube a Git (contiene credenciales).

# MongoDB local (WSL / Compass)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logismart

# MongoDB Atlas (clúster del profesor): reemplaza usuario, contraseña y host
# MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=logismart_equipoX

# Servidor de Ollama
OLLAMA_HOST=http://localhost:11434

# Solo si se desactiva el modo simulación de correo
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=correo@ejemplo.com
# SMTP_PASSWORD=contraseña_de_aplicacion
